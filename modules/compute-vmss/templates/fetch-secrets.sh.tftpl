#!/usr/bin/env bash
# Builds /etc/app/app.env from Key Vault using the instance's managed identity.
# No secrets are baked into the image or the scale set definition.
set -euo pipefail

VAULT="${key_vault_name}"

token() {
  curl -fsS -H Metadata:true \
    "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net" \
    | jq -r .access_token
}

secret() {
  curl -fsS -H "Authorization: Bearer $TOKEN" \
    "https://$VAULT.vault.azure.net/secrets/$1?api-version=7.4" | jq -r .value
}

# On first boot the identity's Key Vault role may still be propagating: retry.
for attempt in $(seq 1 30); do
  if TOKEN="$(token)" && PG_PASSWORD="$(secret postgres-password)"; then
    break
  fi
  echo "Key Vault not reachable yet (attempt $attempt), retrying in 20s" >&2
  sleep 20
done
[ -n "$${PG_PASSWORD:-}" ] || { echo "Could not read secrets from Key Vault" >&2; exit 1; }

umask 077
tmp="$(mktemp /etc/app/.app.env.XXXXXX)"
cat /etc/app/app.env.static > "$tmp"
echo "PGPASSWORD=$PG_PASSWORD" >> "$tmp"
%{ if redis_enabled ~}
# Access keys are base64 and may contain / + =, which break a URL: encode it.
REDIS_KEY="$(secret redis-access-key | jq -sRr 'rtrimstr("\n") | @uri')"
echo "REDIS_URL=rediss://:$REDIS_KEY@${redis_host}:10000" >> "$tmp"
%{ endif ~}
mv "$tmp" /etc/app/app.env
